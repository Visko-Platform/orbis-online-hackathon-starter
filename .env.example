# Copy to .env.local (never commit it).
REACTOR_API_KEY=replace_with_your_reactor_api_key   # server-side only; the browser gets a session-scoped JWT
GEMINI_API_KEY=replace_with_your_gemini_api_key     # Nano Banana Pro keyframes + prompt writing + planner

# Optional
# SITE_PASSWORD=...                         # password-gate the whole site (proxy.ts); unset = open
# NEXT_PUBLIC_SITE_URL=https://your.domain  # public URL (storefront JSON-LD, story replays); default http://localhost:3000
# CACHE_DIR=/var/lib/lifecast               # pre-render / plan / controls cache (default ./.cache)
# PROFILE_DIR=/var/log/lifecast             # profiling JSONL (default ./logs)
# MAX_IMAGE_JOBS=10                         # concurrent Gemini image jobs
